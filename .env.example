# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Recommended during development; omit to register commands globally.
DISCORD_GUILD_ID=

# Access control: comma-separated Discord IDs. Server administrators are always allowed.
OWNER_USER_IDS=
ALLOWED_ROLE_IDS=

# Gemini powers /assistant. Other features work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEFAULT_TIMEZONE=Asia/Kolkata
DATA_FILE=data/assistant.json
LOG_LEVEL=info

# Optional external MCP servers. Copy .mcp.example.json to .mcp.json first.
MCP_CONFIG_FILE=

# Optional TradingView alert ingestion. No market-data API key is required.
# Generate a long random secret, expose this port through HTTPS, and include
# it as the `secret` field in TradingView's JSON alert message.
WEBHOOK_PORT=
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_GUILD_ID=
TRADINGVIEW_USER_ID=
